# Database (PostgreSQL)
DATABASE_URL=postgresql://ideascope:ideascope_dev@localhost:5432/ideascope

# Redis (used by RQ worker)
REDIS_URL=redis://redis:6379/0

# Anthropic (Claude AI for analysis)
ANTHROPIC_API_KEY=

# Reddit API (community scanning)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=

# Auth — user seeding (local dev only — set all three to create a login on first boot)
# SEED_DEV_USER=true
# DEFAULT_USER_EMAIL=you@example.com
# DEFAULT_USER_PASSWORD=your-password-here

# Session
SESSION_SECRET_KEY=change-me-to-a-random-string
SESSION_TTL_HOURS=24
# COOKIE_SECURE=false  # Set to false for local dev (http://localhost)

# Secrets encryption — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRETS_MASTER_KEY=

# Frontend API base URL
NEXT_PUBLIC_API_URL=http://localhost:8000
